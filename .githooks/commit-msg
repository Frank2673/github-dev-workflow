#!/bin/sh
# ============================================================
# commit-msg 钩子：强制 Conventional Commits 规范
# 启用方式：scripts/setup-hooks.ps1 (Windows) 或 setup-hooks.sh
# 本文件随仓库分发，clone 后执行一次 setup 即可生效
# ============================================================

MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$MSG_FILE")

# 放行 merge / revert / fixup 等自动生成的信息
case "$FIRST_LINE" in
  Merge*|Revert*|fixup!*|squash!*|wip*) exit 0 ;;
esac

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?!?: .+'

if echo "$FIRST_LINE" | grep -Eq "$PATTERN"; then
  exit 0
fi

echo ""
echo "❌ 提交信息不符合 Conventional Commits 规范"
echo "   格式: <type>(<scope>): <描述>"
echo "   示例: feat: 添加自动部署流水线"
echo "         fix(ci): 修复缓存键冲突"
echo "   type 可选: feat fix docs style refactor perf test build ci chore revert"
echo ""
exit 1
